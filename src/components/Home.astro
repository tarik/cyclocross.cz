---
import Base from '../layouts/Base.astro';
import Calendar from './Calendar.astro';
import Directory from './Directory.astro';
import HeroPlaceholder from './HeroPlaceholder.astro';
import Upcoming from './Upcoming.astro';
import { site } from '../config/site.ts';
import { formatEventDate, todayInPrague } from '../lib/dates.ts';
import { loadDataset } from '../lib/events.ts';
import { fragments, routePath, type Locale } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/ui.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const id = (key: keyof typeof fragments) => fragments[key][locale];
const dataset = await loadDataset();
const today = todayInPrague();
const lastChecked = dataset.events.map((event) => event.updatedDate).sort().at(-1);
---

<Base locale={locale} variant="home">
  <HeroPlaceholder slot="hero" locale={locale} />

  <section class="section wrap" id={id('upcoming')} aria-labelledby="upcoming-title">
    <h2 id="upcoming-title">{t('home.upcoming.title')}</h2>
    <Upcoming locale={locale} dataset={dataset} today={today} />
  </section>

  <section class="section wrap" id={id('calendar')} aria-labelledby="calendar-title">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6">
      <h2 id="calendar-title">{t('home.calendar.title')}</h2>
      <p class="text-ink-soft">
        {t('cal.season')} {site.activeSeason.replace('-', '–')}
        {lastChecked && ` · ${t('data.updated')} ${formatEventDate(lastChecked, locale)}`}
      </p>
    </div>
    <Calendar locale={locale} dataset={dataset} today={today} />
  </section>

  <section class="section wrap" id={id('directory')} aria-labelledby="directory-title">
    <h2 id="directory-title">{t('home.directory.title')}</h2>
    <Directory locale={locale} dataset={dataset} />
  </section>

  <section class="section wrap" id={id('contribute')} aria-labelledby="contribute-title">
    <h2 id="contribute-title">{t('home.contribute.title')}</h2>
    <p>{t('home.contribute.lead')}</p>
    <p class="flex max-w-none flex-wrap gap-2">
      <a class="pill pill-primary" href={`${site.issuesUrl}/new?template=add-event.yml`}>{t('contribute.add')}</a>
      <a class="pill" href={`${site.issuesUrl}/new?template=correct-event.yml`}>{t('contribute.correct')}</a>
      <a class="pill" href={routePath('contribute', locale)}>{t('home.contribute.cta')}</a>
    </p>
  </section>
</Base>

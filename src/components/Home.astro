---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroPlaceholder from './HeroPlaceholder.astro';
import { formatEventDate } from '../lib/dates.ts';
import { fragments, htmlLang, routePath, type Locale } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/ui.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const id = (key: keyof typeof fragments) => fragments[key][locale];

// Foundation only: a plain list proves the data pipeline. The real calendar
// (table, filters, details) is delivered in the calendar PR.
const events = (await getCollection('events')).map((entry) => entry.data).sort((a, b) =>
  (a.timing.startDate ?? '9999').localeCompare(b.timing.startDate ?? '9999'),
);
---

<Base locale={locale} variant="home">
  <HeroPlaceholder slot="hero" locale={locale} />

  <section class="section wrap" id={id('upcoming')} aria-labelledby="upcoming-title">
    <h2 id="upcoming-title">{t('home.upcoming.title')}</h2>
    <p class="muted">{t('home.pending')}</p>
  </section>

  <section class="section wrap" id={id('calendar')} aria-labelledby="calendar-title">
    <h2 id="calendar-title">{t('home.calendar.title')}</h2>
    {
      events.length === 0 ? (
        <p class="muted">{t('home.pending')}</p>
      ) : (
        <ul class="events">
          {events.map((event) => (
            <li data-event={event.id}>
              <span class="date">{event.timing.startDate ? formatEventDate(event.timing.startDate, locale) : '?'}</span>
              <span class="name" lang={htmlLang.cs}>{event.name.official}</span>
              <span class="muted">{event.location.town}</span>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="section wrap" id={id('directory')} aria-labelledby="directory-title">
    <h2 id="directory-title">{t('home.directory.title')}</h2>
    <p class="muted">{t('home.pending')}</p>
  </section>

  <section class="section wrap" id={id('contribute')} aria-labelledby="contribute-title">
    <h2 id="contribute-title">{t('home.contribute.title')}</h2>
    <p>{t('home.contribute.lead')}</p>
    <p><a href={routePath('contribute', locale)}>{t('home.contribute.cta')}</a></p>
  </section>
</Base>

<style>
  .events {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }
  .events li {
    display: grid;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
  }
  .date { font-variant-numeric: tabular-nums; }
  .name { font-weight: 600; overflow-wrap: anywhere; }
  @media (min-width: 48rem) {
    .events li { grid-template-columns: 14rem 1fr 10rem; align-items: baseline; }
  }
</style>

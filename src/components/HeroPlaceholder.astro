---
/**
 * Reserved-size stand-in for the hero scene. It only holds the space and the
 * HTML introduction; the pixel-art landscape arrives with the art PRs and is
 * not represented here.
 */
import { sectionPath, type Locale } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/ui.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="flex min-h-60 flex-col justify-between md:min-h-88" aria-labelledby="hero-title">
  <div class="wrap pt-4 pb-6">
    <h1 id="hero-title">{t('hero.title')}</h1>
    <p class="max-w-136 text-xl leading-[1.45]">{t('hero.lead')}</p>
    <a class="button" href={sectionPath('calendar', locale)}>{t('hero.cta')}</a>
  </div>
  <div class="ground" aria-hidden="true"></div>
</section>

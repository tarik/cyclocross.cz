---
/**
 * Actual-size specimen of the heading and body candidates. Fonts are loaded
 * only on this page.
 */
import '@fontsource/jersey-10/latin-400.css';
import '@fontsource/jersey-10/latin-ext-400.css';
import '@fontsource/jersey-20/latin-400.css';
import '@fontsource/jersey-20/latin-ext-400.css';
import '@fontsource/jersey-25/latin-400.css';
import '@fontsource/jersey-25/latin-ext-400.css';
import '@fontsource/pixelify-sans/latin-400.css';
import '@fontsource/pixelify-sans/latin-ext-400.css';
import '@fontsource/tiny5/latin-400.css';
import '@fontsource/tiny5/latin-ext-400.css';
import '@fontsource/handjet/latin-400.css';
import '@fontsource/handjet/latin-ext-400.css';
import '@fontsource/micro-5/latin-400.css';
import '@fontsource/micro-5/latin-ext-400.css';
import '@fontsource/atkinson-hyperlegible/latin-400.css';
import '@fontsource/atkinson-hyperlegible/latin-ext-400.css';
import '@fontsource/atkinson-hyperlegible/latin-700.css';
import '@fontsource/atkinson-hyperlegible/latin-ext-700.css';
import '@fontsource-variable/source-sans-3/wght.css';
import { withBase } from '../../i18n/routes.ts';

const display = [
  { name: 'Jersey 15', note: 'Current choice.', current: true },
  { name: 'Jersey 10', note: 'Same family, lighter and wider.' },
  { name: 'Jersey 20', note: 'Same family, heavier.' },
  { name: 'Jersey 25', note: 'Same family, heaviest.' },
  { name: 'Pixelify Sans', note: 'Spec default candidate. C reads like O, Z like 2.' },
  { name: 'Tiny5', note: 'Spec candidate. Five pixels tall, accents are cramped.' },
  { name: 'Handjet', note: 'Dot-matrix look, thin at heading sizes.' },
  { name: 'Micro 5', note: 'Very small design, needs large sizes.' },
];
const body = [
  { name: 'Inter Variable', label: 'Inter', note: 'Current choice.', current: true },
  { name: 'Atkinson Hyperlegible', label: 'Atkinson Hyperlegible', note: 'Designed for legibility, wider letters.' },
  { name: 'Source Sans 3 Variable', label: 'Source Sans 3', note: 'Narrower, fits more per table row.' },
];
const strings = ['Příští závody', 'Kalendář závodů', 'Pořadatelé', 'Přidejte závod', 'Příliš žluťoučký kůň úpěl ďábelské ódy'];
const upper = 'Á Č Ď É Ě Í Ň Ó Ř Š Ť Ú Ů Ý Ž';
const lower = 'á č ď é ě í ň ó ř š ť ú ů ý ž';
const extras = 'CZ EN 0123456789 · 14. 11. 2026 · 10:30 · (UCI C2) · „uvozovky“ – ? ! % &';
const sample = 'Závody UCI jsou vypsány pro muže, ženy a juniory, doplňují je národní závody mládeže. Podmínky startu ověřte v propozicích. Štěrk, bláto, překážky a schody: žluťoučký kůň úpěl ďábelské ódy.';
---

<p class="mb-8 max-w-[65ch]">
  Everything below is real HTML text in self-hosted fonts at the sizes the site uses. Please pick one heading font and one body
  font. All candidates shown here contain every Czech letter; fonts that lack them were left out.
</p>

<h2>Heading candidates</h2>
{display.map((font) => (
  <section class="mb-10 border-t-4 border-ink pt-4" data-font={font.name}>
    <p class="mb-3 font-semibold">
      {font.name}
      {font.current && <span class="ml-2 bg-ink px-2 py-0.5 text-sm text-paper">current</span>}
      <span class="ml-2 font-normal text-ink-soft">{font.note}</span>
    </p>
    <div style={`font-family: '${font.name}', monospace`} lang="cs">
      <p class="mb-2 max-w-none text-[3.5rem] leading-[1.1]">Cyklokros v Česku</p>
      {strings.map((text) => <p class="mb-1 max-w-none text-4xl leading-[1.15]">{text}</p>)}
      <p class="mt-3 mb-1 max-w-none text-[1.75rem] leading-[1.2]">{upper}</p>
      <p class="mb-1 max-w-none text-[1.75rem] leading-[1.2]">{lower}</p>
      <p class="mb-1 max-w-none text-xl leading-[1.3]">{extras}</p>
      <p class="max-w-none text-xl leading-[1.3]">cyclocross.cz · JANEV Cup Jičín · Vimperský cyklokros na Vodníku</p>
    </div>
  </section>
))}

<h2>Body candidates</h2>
<div class="mb-12 grid gap-8 lg:grid-cols-3">
  {body.map((font) => (
    <section class="border-t-4 border-ink pt-4" style={`font-family: '${font.name}', sans-serif`} lang="cs">
      <p class="mb-3 font-semibold" lang="en">
        {font.label}
        {font.current && <span class="ml-2 bg-ink px-2 py-0.5 text-sm text-paper">current</span>}
        <span class="mt-1 block font-normal text-ink-soft">{font.note}</span>
      </p>
      <p class="mb-3">{sample}</p>
      <p class="mb-3 text-sm">{sample}</p>
      <p class="mb-1 font-semibold">so 14. 11. 2026 · Jičín · Královéhradecký kraj</p>
      <p class="mb-1">{upper}</p>
      <p class="mb-1">{lower}</p>
      <p>0123456789 · Il1 O0 · rn m</p>
    </section>
  ))}
</div>

<h2>Wordmark</h2>
<p class="mb-6 max-w-[65ch]">Three directions for the fixed wordmark. Each keeps the name as real text.</p>
<div class="grid gap-6 lg:grid-cols-3">
  <div class="border-2 border-ink bg-sky-1 p-6">
    <p class="mb-4 font-semibold">A · Text only (current)</p>
    <p class="font-display text-[2rem] leading-none">cyclocross.cz</p>
  </div>
  <div class="border-2 border-ink bg-sky-1 p-6">
    <p class="mb-4 font-semibold">B · With a pixel wheel</p>
    <p class="flex items-center gap-2 font-display text-[2rem] leading-none">
      <img src={withBase('/art/mark-wheel.png')} alt="" width="23" height="23" class="h-[46px] w-[46px] [image-rendering:pixelated]" />
      cyclocross.cz
    </p>
  </div>
  <div class="border-2 border-ink bg-sky-1 p-6">
    <p class="mb-4 font-semibold">C · On course tape</p>
    <p class="inline-block font-display text-[2rem] leading-none">
      cyclocross.cz
      <span class="mt-1 block h-2 bg-[repeating-linear-gradient(90deg,var(--color-accent)_0_12px,var(--color-surface)_12px_24px)] outline-2 outline-ink"></span>
    </p>
  </div>
</div>

---
/**
 * The calendar: a semantic table at desktop widths that reflows into cards on
 * phones. It is complete without JavaScript (every row links to its event
 * page); the script adds filters, in-place details and date regrouping.
 */
import EventDetails from './EventDetails.astro';
import StatusBadge from './StatusBadge.astro';
import { regions } from '../config/regions.ts';
import { site } from '../config/site.ts';
import { isPast } from '../lib/calendar-filter.ts';
import { formatShortDate } from '../lib/dates.ts';
import { eventView, type EventView } from '../lib/event-view.ts';
import type { Dataset } from '../lib/events.ts';
import { htmlLang, seasonFeedPath, type Locale } from '../i18n/routes.ts';
import { ui, useTranslations } from '../i18n/ui.ts';

interface Props {
  locale: Locale;
  dataset: Dataset;
  today: string;
}
const { locale, dataset, today } = Astro.props;
const t = useTranslations(locale);

const views = dataset.events.filter((event) => event.seasonId === site.activeSeason).map((event) => eventView(event, locale, dataset, today));
const dated = views.filter((view) => view.index.date);
const groups = [
  { key: 'upcoming', title: t('cal.upcoming'), views: dated.filter((view) => !isPast(view.index, today)) },
  { key: 'unconfirmed', title: t('cal.unconfirmed'), views: views.filter((view) => !view.index.date) },
  { key: 'past', title: t('cal.past'), views: dated.filter((view) => isPast(view.index, today)).reverse() },
] as const;

const usedRegions = Object.keys(regions).filter((id) => views.some((view) => view.index.region === id));
const usedSeries = [...dataset.series.values()].filter((series) => views.some((view) => view.index.series.includes(series.id)));
const typeOptions = (['elite', 'amateur', 'masters', 'juniors'] as const).filter((type) => views.some((view) => view.index.types.includes(type)));
const hasYoung = views.some((view) => view.index.types.includes('young'));
const columns = ['date', 'event', 'place', 'series', 'who', 'status', 'details'] as const;
const strings = {
  one: t('filter.count.one'),
  few: t('filter.count.few'),
  many: t('filter.count.many'),
  label: t('filter.count.label'),
  past: t('status.past'),
  locale,
};
---

<div class="calendar" data-calendar data-strings={JSON.stringify(strings)}>
  <form class="filters" data-filters hidden role="search" aria-label={t('filter.title')}>
    <div class="fields">
      <label class="field wide">
        <span>{t('filter.q')}</span>
        <input type="search" name="q" placeholder={t('filter.qPlaceholder')} autocomplete="off" maxlength="80" />
      </label>
      <label class="field">
        <span>{t('filter.region')}</span>
        <select name="region">
          <option value="">{t('filter.all')}</option>
          {usedRegions.map((id) => <option value={id}>{regions[id as keyof typeof regions][locale]}</option>)}
        </select>
      </label>
      <label class="field">
        <span>{t('filter.series')}</span>
        <select name="series">
          <option value="">{t('filter.all')}</option>
          {usedSeries.map((series) => <option value={series.id}>{series.name}</option>)}
        </select>
      </label>
      <label class="field">
        <span>{t('filter.type')}</span>
        <select name="type">
          <option value="">{t('filter.all')}</option>
          {typeOptions.map((type) => <option value={type}>{ui[locale][`type.${type}`]}</option>)}
          {hasYoung && <option value="young">{t('filter.children')}</option>}
        </select>
      </label>
      <label class="field">
        <span>{t('filter.from')}</span>
        <input type="date" name="from" />
      </label>
      <label class="field">
        <span>{t('filter.to')}</span>
        <input type="date" name="to" />
      </label>
    </div>
    <div class="shortcuts">
      <button type="button" class="chip" data-shortcut="weekend" aria-pressed="false">{t('filter.weekend')}</button>
      <button type="button" class="chip" data-shortcut="amateur" aria-pressed="false">{t('filter.amateur')}</button>
      {hasYoung && <button type="button" class="chip" data-shortcut="young" aria-pressed="false">{t('filter.children')}</button>}
      <button type="reset" class="chip reset" data-reset hidden>{t('filter.reset')}</button>
      <p class="count" role="status" data-count></p>
    </div>
  </form>

  {
    groups.map((group) => {
      const table = (
        <table data-table={group.key}>
          <caption class="visually-hidden">{group.title}</caption>
          <thead>
            <tr>
              {columns.map((column) => (
                <th scope="col" class={`col-${column}`}>
                  {column === 'details' ? <span class="visually-hidden">{t('cal.col.details')}</span> : t(`cal.col.${column}`)}
                </th>
              ))}
            </tr>
          </thead>
          {group.views.map((view: EventView) => (
            <tbody
              id={view.anchor}
              data-event
              data-date={view.index.date ?? ''}
              data-end={view.index.endDate ?? ''}
              data-text={view.index.text}
              data-region={view.index.region}
              data-series={view.index.series.join(' ')}
              data-types={view.index.types.join(' ')}
            >
              <tr class="main">
                <td class="col-date">
                  {view.index.date ? <time datetime={view.index.date}>{formatShortDate(view.index.date, locale)}</time> : '–'}
                  {view.index.date && <span class="year"> {view.index.date.slice(0, 4)}</span>}
                </td>
                <th scope="row" class="col-event">
                  <a href={view.path} lang={htmlLang.cs}>
                    {view.name}
                  </a>
                </th>
                <td class="col-place">
                  <span lang={htmlLang.cs}>{view.town}</span>
                  {view.region && <span class="sub">{view.region}</span>}
                </td>
                <td class="col-series">
                  {view.series.length > 0 ? view.series.map((series) => <span lang={htmlLang.cs}>{series.name}</span>) : <span class="sub">{t('cal.noSeries')}</span>}
                </td>
                <td class="col-who">{view.typeLabels.length > 0 ? view.typeLabels.join(', ') : <span class="sub">{t('cal.unknown')}</span>}</td>
                <td class="col-status">
                  <StatusBadge status={view.status} label={view.statusLabel} />
                </td>
                <td class="col-details">
                  <button type="button" class="expand" data-expand aria-expanded="false" aria-controls={`${view.anchor}-details`} hidden>
                    {t('cal.showDetails')}
                    <span class="visually-hidden">: {view.name}</span>
                  </button>
                  <a class="page-link" href={view.path} data-page-link>
                    {t('cal.showDetails')}
                    <span class="visually-hidden">: {view.name}</span>
                  </a>
                </td>
              </tr>
              <tr class="detail" id={`${view.anchor}-details`} hidden>
                <td colspan={columns.length}>
                  <EventDetails view={view} locale={locale} dataset={dataset} heading="h4">
                    <a slot="actions" href={view.path}>
                      {t('cal.eventPage')}
                    </a>
                  </EventDetails>
                </td>
              </tr>
            </tbody>
          ))}
        </table>
      );
      if (group.key === 'past') {
        return (
          <details class="group past" data-group="past" hidden={group.views.length === 0}>
            <summary>
              <h3>{group.title}</h3> <span class="sub" data-group-count>({group.views.length})</span>
            </summary>
            {table}
          </details>
        );
      }
      return (
        <section class="group" data-group={group.key} hidden={group.key === 'unconfirmed' && group.views.length === 0}>
          <h3 class={group.key === 'upcoming' ? 'visually-hidden' : undefined}>{group.title}</h3>
          {table}
          {group.key === 'upcoming' && (
            <p class="empty" data-empty hidden={group.views.length > 0} data-empty-default={t('cal.emptyUpcoming')} data-empty-filtered={t('cal.empty')}>
              {t('cal.emptyUpcoming')}
            </p>
          )}
        </section>
      );
    })
  }

  <p class="feed">
    <a href={seasonFeedPath(site.activeSeason)}>{t('cal.subscribe')}</a>
    <span class="sub">{t('cal.subscribeNote')}</span>
  </p>
</div>

<script>
  import { initCalendar } from '../scripts/calendar.ts';
  for (const root of document.querySelectorAll<HTMLElement>('[data-calendar]')) initCalendar(root);
</script>

<style>
  .filters {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding: var(--space-3);
    background: var(--color-surface);
    border: var(--border);
    box-shadow: var(--shadow);
  }
  .fields {
    display: grid;
    gap: var(--space-2) var(--space-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 60rem) {
    .fields { grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1.1fr)) repeat(2, minmax(9.5rem, 1fr)); }
    .fields .field.wide { grid-column: auto; }
  }
  .field { display: grid; gap: 2px; min-width: 0; font-size: var(--step--1); font-weight: 600; }
  .field.wide { grid-column: span 2; }
  .field input,
  .field select {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0 var(--space-2);
    font: 400 var(--step-0) var(--font-body);
    color: var(--color-ink);
    background: #fff;
    border: 2px solid var(--color-ink);
    border-radius: 0;
  }
  .shortcuts { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
  .chip {
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    font: 600 var(--step--1) var(--font-body);
    color: var(--color-ink);
    background: var(--color-paper);
    border: 2px solid var(--color-ink);
    cursor: pointer;
  }
  .chip[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); }
  .chip.reset { border-style: dashed; }
  .count { margin: 0 0 0 auto; font-weight: 600; }

  .group { margin-bottom: var(--space-4); }
  .group h3 { font-size: var(--step-1); }
  details.group > summary { cursor: pointer; padding-block: var(--space-2); min-height: 2.75rem; }
  details.group > summary h3 { display: inline; margin: 0; }

  table { width: 100%; border-collapse: collapse; }
  thead th {
    padding: var(--space-2);
    text-align: left;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    border-bottom: 2px solid var(--color-ink);
  }
  tbody { border-bottom: 1px solid var(--color-line); }
  .main > * { padding: var(--space-3) var(--space-2); vertical-align: top; text-align: left; }
  .col-date { white-space: nowrap; font-variant-numeric: tabular-nums; font-weight: 600; }
  .year { font-weight: 400; color: var(--color-ink-soft); }
  .col-event { font-weight: 400; }
  @media (min-width: 60rem) {
    .col-event { width: 27%; }
    .col-place { width: 16%; }
    .col-series { width: 16%; }
    .col-who { width: 17%; }
  }
  .col-event a { font-weight: 700; color: var(--color-ink); overflow-wrap: anywhere; }
  .col-series span { display: block; }
  .sub { display: block; font-size: var(--step--1); color: var(--color-ink-soft); }
  span.sub[data-group-count] { display: inline; }
  .col-details { text-align: right; white-space: nowrap; }
  .expand,
  .page-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-2);
    font: 600 var(--step--1) var(--font-body);
    color: var(--color-accent);
    background: none;
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .expand::after {
    content: '';
    margin-left: 0.4em;
    border: 5px solid transparent;
    border-top-color: currentColor;
    border-bottom-width: 0;
  }
  .expand[aria-expanded='true']::after { transform: rotate(180deg); }
  .expand[hidden],
  .page-link[hidden] { display: none; }
  .detail > td {
    padding: var(--space-3) var(--space-3) var(--space-4);
    background: var(--color-surface);
    border-left: var(--pixel) solid var(--color-accent);
  }
  tbody.is-cancelled .col-event a { text-decoration: line-through; }
  .empty { padding: var(--space-4) 0; font-weight: 600; }
  .feed { margin-top: var(--space-4); }
  .feed a { font-weight: 600; }

  /* Phones and small tablets: each event becomes a card. Roles are set by the
     script-free markup below so the table semantics survive display changes. */
  @media (max-width: 59.99rem) {
    table, tbody, tr, td, th { display: block; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    tr[hidden] { display: none; }
    tbody { padding-block: var(--space-3); }
    .main {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 2px var(--space-3);
    }
    .main > * { padding: 0; }
    .col-date { grid-column: 1; }
    .col-status { grid-column: 2; grid-row: 1; justify-self: end; }
    .col-event { grid-column: 1 / -1; font-size: 1.125rem; padding-block: 2px; }
    .col-place, .col-series, .col-who { grid-column: 1 / -1; }
    .col-place .sub, .col-series span { display: inline; }
    .col-place .sub::before { content: ' · '; }
    .col-series, .col-who { font-size: var(--step--1); color: var(--color-ink-soft); }
    .col-details { grid-column: 1 / -1; text-align: left; }
    .expand, .page-link { padding-inline: 0; }
    .detail > td { margin-top: var(--space-2); }
    .field.wide { grid-column: 1 / -1; }
    .count { margin-left: 0; flex-basis: 100%; }
  }
</style>

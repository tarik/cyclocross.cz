---
import { site } from '../config/site.ts';
import { routePath, supportingPages, type Locale } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/ui.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="mt-16 bg-ink py-10 text-paper [&_:focus-visible]:outline-[#ffd866]">
  <div class="wrap grid grid-cols-[repeat(auto-fit,minmax(16rem,1fr))] gap-x-16 gap-y-6">
    <div>
      <p class="font-display text-4xl leading-none">cyclocross.cz</p>
      <p class="text-footer-text">{t('footer.independent')}</p>
    </div>
    <nav aria-label={t('footer.pages')}>
      <ul class="grid gap-1">
        {
          supportingPages.map((page) => (
            <li>
              <a class="inline-flex min-h-11 items-center text-paper" href={routePath(page, locale)}>{t(`page.${page}`)}</a>
            </li>
          ))
        }
        <li><a class="inline-flex min-h-11 items-center text-paper" href={site.repositoryUrl}>{t('footer.source')}</a></li>
      </ul>
    </nav>
  </div>
</footer>

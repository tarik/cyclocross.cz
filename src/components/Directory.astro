---
import { site } from '../config/site.ts';
import type { Dataset } from '../lib/events.ts';
import { htmlLang, sectionPath, type Locale } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/ui.ts';

interface Props {
  locale: Locale;
  dataset: Dataset;
}
const { locale, dataset } = Astro.props;
const t = useTranslations(locale);
const series = [...dataset.series.values()]
  .filter((item) => item.seasonIds.includes(site.activeSeason))
  .map((item) => ({ item, races: dataset.events.filter((event) => event.seriesIds.includes(item.id)).length }))
  .sort((a, b) => b.races - a.races);
---

<ul class="mb-4 grid grid-cols-[repeat(auto-fit,minmax(min(100%,18rem),1fr))] gap-6">
  {
    series.map(({ item, races }) => (
      <li class="flex flex-col border-t-4 border-ink pt-4">
        <h3 class="mb-1 text-[1.75rem]" lang={htmlLang.cs}>{item.name}</h3>
        {item.scope && <p class="eyebrow">{item.scope[locale] ?? item.scope.cs}</p>}
        {item.description && <p>{item.description[locale] ?? item.description.cs}</p>}
        <p class="mt-auto flex max-w-none flex-wrap gap-2">
          <a class="pill pill-primary" href={`${sectionPath('calendar', locale).replace('#', `?series=${item.id}#`)}`}>
            {races} {t('dir.races')}
          </a>
          {item.website && <a class="pill" href={item.website} rel="noopener">{t('dir.website')}</a>}
          {item.calendarUrl && item.calendarUrl !== item.website && <a class="pill" href={item.calendarUrl} rel="noopener">{t('dir.calendar')}</a>}
        </p>
      </li>
    ))
  }
</ul>
<p class="text-ink-soft">{t('dir.editorial')}</p>

---
import { equivalentPath, fragments, htmlLang, locales, otherLocale, routePath, type Locale } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/ui.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const target = otherLocale(locale);
const href = equivalentPath(Astro.url.pathname, target) ?? routePath('home', target);
const labels: Record<Locale, string> = { cs: 'CZ', en: 'EN' };
// Lets the enhancement below carry a homepage section across languages.
const fragmentMap = Object.fromEntries(Object.values(fragments).map((ids) => [ids[locale], ids[target]]));
---

<p class="lang" aria-label={t('lang.label')} role="group">
  {
    locales.map((code) =>
      code === locale ? (
        <span class="current" aria-current="true" lang={htmlLang[code]}>
          <span class="visually-hidden">{t('lang.current')}</span>
          <span aria-hidden="true">{labels[code]}</span>
        </span>
      ) : (
        <a href={href} hreflang={htmlLang[code]} lang={htmlLang[code]} data-lang-switch data-fragments={JSON.stringify(fragmentMap)}>
          <span class="visually-hidden">{t('lang.switchTo')}</span>
          <span aria-hidden="true">{labels[code]}</span>
        </a>
      ),
    )
  }
</p>

<script>
  // Keep filters (query string) and the current section when switching language.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]')) {
    link.addEventListener('click', () => {
      const url = new URL(link.href);
      url.search = window.location.search;
      const fragment = window.location.hash.slice(1);
      if (fragment) {
        const map = JSON.parse(link.dataset.fragments ?? '{}') as Record<string, string>;
        url.hash = map[fragment] ?? fragment;
      }
      link.href = url.href;
    });
  }
</script>

<style>
  .lang {
    display: inline-flex;
    margin: 0;
    border: var(--border);
    background: var(--color-surface);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    align-self: flex-start;
  }
  .lang a,
  .lang .current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.5rem;
    padding-inline: var(--space-2);
    color: var(--color-ink);
    text-decoration: none;
  }
  .lang .current {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .lang a:hover { background: var(--color-line); }
</style>

---
import { equivalentPath, fragments, htmlLang, locales, otherLocale, routePath, type Locale } from '../i18n/routes.ts';
import { useTranslations } from '../i18n/ui.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const target = otherLocale(locale);
const href = equivalentPath(Astro.url.pathname, target) ?? routePath('home', target);
const labels: Record<Locale, string> = { cs: 'CZ', en: 'EN' };
// Lets the enhancement below carry a homepage section across languages.
const fragmentMap = Object.fromEntries(Object.values(fragments).map((ids) => [ids[locale], ids[target]]));
---

<p class="m-0 inline-flex self-start border-2 border-ink bg-surface font-display text-2xl leading-none" aria-label={t('lang.label')} role="group">
  {
    locales.map((code) =>
      code === locale ? (
        <span class="inline-flex min-h-10 min-w-11 items-center justify-center bg-ink px-2 text-paper" aria-current="true" lang={htmlLang[code]}>
          <span class="sr-only">{t('lang.current')}</span>
          <span aria-hidden="true">{labels[code]}</span>
        </span>
      ) : (
        <a class="inline-flex min-h-10 min-w-11 items-center justify-center px-2 text-ink no-underline hover:bg-line" href={href} hreflang={htmlLang[code]} lang={htmlLang[code]} data-lang-switch data-fragments={JSON.stringify(fragmentMap)}>
          <span class="sr-only">{t('lang.switchTo')}</span>
          <span aria-hidden="true">{labels[code]}</span>
        </a>
      ),
    )
  }
</p>

<script>
  // Keep filters (query string) and the current section when switching language.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]')) {
    link.addEventListener('click', () => {
      const url = new URL(link.href);
      url.search = window.location.search;
      const fragment = window.location.hash.slice(1);
      if (fragment) {
        const map = JSON.parse(link.dataset.fragments ?? '{}') as Record<string, string>;
        url.hash = map[fragment] ?? fragment;
      }
      link.href = url.href;
    });
  }
</script>
